# App origins (dev). In prod, SERVE_ORIGIN must be a SEPARATE registrable domain.
APP_ORIGIN=http://localhost:3000
SERVE_ORIGIN=http://localhost:3001
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Better Auth secret: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Database (Neon)
DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/kiosk?sslmode=require

# OAuth (infra-managed; create apps in GitHub/Google consoles)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
