# App origins (dev). In prod, SERVE_ORIGIN must be a SEPARATE registrable domain.
APP_ORIGIN=http://localhost:3000
SERVE_ORIGIN=http://localhost:3001
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Required in production: comma-separated MCP browser/preview allowlists.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# P9 runtime protection. Production requires an HTTPS serverless Redis REST
# endpoint, its access token, and an independent 32-byte key used only to HMAC
# identifiers before they become Redis keys.
RATE_LIMIT_REDIS_REST_URL=
RATE_LIMIT_REDIS_REST_TOKEN=
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
RATE_LIMIT_KEY_SECRET=
# Production on Vercel: x-vercel-forwarded-for. Comma-separated allowlisted names.
TRUSTED_CLIENT_IP_HEADERS=x-vercel-forwarded-for

# Optional positive-integer protection overrides. Blank uses the code default.
KIOSK_RATE_AUTH_POST_LIMIT=
KIOSK_RATE_AUTH_POST_WINDOW_SECONDS=
KIOSK_RATE_CLI_MINT_PRE_AUTH_LIMIT=
KIOSK_RATE_CLI_MINT_PRE_AUTH_WINDOW_SECONDS=
KIOSK_RATE_CLI_MINT_POST_AUTH_LIMIT=
KIOSK_RATE_CLI_MINT_POST_AUTH_WINDOW_SECONDS=
KIOSK_RATE_API_PRE_AUTH_LIMIT=
KIOSK_RATE_API_PRE_AUTH_WINDOW_SECONDS=
KIOSK_RATE_API_GENERAL_LIMIT=
KIOSK_RATE_API_GENERAL_WINDOW_SECONDS=
KIOSK_RATE_API_WRITE_LIMIT=
KIOSK_RATE_API_WRITE_WINDOW_SECONDS=
KIOSK_RATE_API_EXPORT_LIMIT=
KIOSK_RATE_API_EXPORT_WINDOW_SECONDS=
KIOSK_RATE_REPORT_LIMIT=
KIOSK_RATE_REPORT_WINDOW_SECONDS=
KIOSK_RATE_RENDER_DAILY_LIMIT=
KIOSK_RATE_RENDER_DAILY_WINDOW_SECONDS=
KIOSK_QUOTA_ACTIVE_PAGES=
KIOSK_QUOTA_RETAINED_BYTES=
KIOSK_QUOTA_ACTIVE_TOKENS=
KIOSK_QUOTA_MEMBERS=
KIOSK_QUOTA_INVITATIONS=
KIOSK_QUOTA_RENDER_CONCURRENCY=

# Release identifier exposed by /healthz (Git SHA or immutable release tag).
KIOSK_RELEASE_ID=development

# P9 operations. Production must explicitly select stdout (with a configured
# platform log drain) or an HTTPS HTTP ingestion endpoint. Use a separate HMAC
# key so operational identifiers cannot be correlated with rate-limit keys.
OPERATIONS_SINK=stdout
OPERATIONS_HTTP_ENDPOINT=
OPERATIONS_HTTP_TOKEN=
OPERATIONS_HTTP_TIMEOUT_MS=2000
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
OPERATIONS_HASH_SECRET=

# Platform operators allowed to access infrastructure administration.
KIOSK_ADMIN_EMAILS=

# P8 content storage. Defaults to external mode backed by a local folder
# (STORAGE_LOCAL_DIR, default ./data/storage) until an external S3/R2/Vercel Blob
# profile is configured as default in /settings/storage.
# Generate STORAGE_CREDENTIAL_KEY (needed when storing external cloud credentials):
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
CONTENT_STORAGE_MODE=external
STORAGE_LOCAL_DIR=
STORAGE_CREDENTIAL_KEY=
STORAGE_ALLOWED_ENDPOINT_HOSTS=

# Render service. Generate the shared secret with the same 32-byte command.
RENDER_SERVICE_URL=http://localhost:8787
RENDER_SHARED_SECRET=

# Better Auth secret: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Database (Neon)
DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/kiosk?sslmode=require

# OAuth (infra-managed; create apps in GitHub/Google consoles)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
