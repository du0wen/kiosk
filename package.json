{
  "name": "kiosk",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:unit": "node --test scripts/*.test.mjs && node scripts/run-test-group.mjs unit",
    "verify:db": "node scripts/run-test-group.mjs db",
    "verify:web": "pnpm lint && pnpm build",
    "verify:render": "pnpm -C render test",
    "verify:cli": "pnpm -C cli build && cargo fmt --manifest-path cli-rs/Cargo.toml --check && cargo clippy --manifest-path cli-rs/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path cli-rs/Cargo.toml && cargo build --release --manifest-path cli-rs/Cargo.toml",
    "verify:release": "pnpm verify:unit && pnpm verify:db && pnpm verify:web && pnpm verify:render && pnpm verify:cli && pnpm config:check && pnpm cli:release:check && git diff --check",
    "cli:release:check": "node scripts/validate-cli-release.mjs",
    "config:check": "tsx scripts/validate-runtime-config.ts",
    "protection:smoke": "tsx scripts/protection-smoke.ts",
    "test:e2e": "tsx scripts/e2e-isolated-smoke.ts && node scripts/e2e-browser-ui.mjs",
    "release:inventory": "node scripts/release-inventory.mjs",
    "storage:migrate": "tsx scripts/storage-migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:generate": "pnpm dlx @better-auth/cli generate --output src/db/schema/auth.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1128.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@modelcontextprotocol/server": "2.0.0",
    "@neondatabase/serverless": "^1.1.0",
    "@upstash/redis": "^1.38.4",
    "@vercel/blob": "^2.8.0",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.24.0",
    "nanoid": "^5.1.16",
    "next": "16.2.10",
    "next-intl": "^4.13.1",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tldts": "^7.4.13",
    "turndown": "^7.2.4",
    "uuid": "^14.0.1",
    "ws": "^8.21.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "happy-dom": "^20.10.6",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
