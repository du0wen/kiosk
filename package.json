{
  "name": "kiosk",
  "version": "0.1.2",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @kiosk/web dev",
    "build": "pnpm --filter @kiosk/web build",
    "start": "pnpm --filter @kiosk/web start",
    "lint": "pnpm --filter @kiosk/web lint",
    "test": "pnpm --filter @kiosk/web test",
    "test:watch": "pnpm --filter @kiosk/web test:watch",
    "verify:unit": "node --test scripts/*.test.mjs && node scripts/run-test-group.mjs unit",
    "verify:db": "node scripts/run-test-group.mjs db",
    "verify:web": "pnpm lint && pnpm build",
    "verify:render": "pnpm -C apps/render test",
    "verify:cli": "cargo fmt --manifest-path packages/cli/Cargo.toml --check && cargo clippy --manifest-path packages/cli/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path packages/cli/Cargo.toml && cargo build --release --manifest-path packages/cli/Cargo.toml",
    "verify:release": "pnpm verify:unit && pnpm verify:db && pnpm verify:web && pnpm verify:render && pnpm verify:cli && pnpm config:check && pnpm cli:release:check && git diff --check",
    "cli:release:check": "node scripts/validate-cli-release.mjs",
    "config:check": "pnpm --filter @kiosk/web exec tsx ../../scripts/validate-runtime-config.ts",
    "protection:smoke": "pnpm --filter @kiosk/web exec tsx ../../scripts/protection-smoke.ts",
    "test:e2e": "pnpm --filter @kiosk/web exec tsx ../../scripts/e2e-isolated-smoke.ts && node scripts/e2e-browser-ui.mjs",
    "release:inventory": "node scripts/release-inventory.mjs",
    "storage:migrate": "pnpm --filter @kiosk/web exec tsx ../../scripts/storage-migrate.ts",
    "db:generate": "pnpm --filter @kiosk/web db:generate",
    "db:migrate": "pnpm --filter @kiosk/web db:migrate",
    "auth:generate": "pnpm --filter @kiosk/web auth:generate"
  },
  "devDependencies": {
    "dotenv": "^17.4.2"
  }
}
