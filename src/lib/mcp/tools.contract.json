[
  {
    "name": "publish_page",
    "description": "Publish a new HTML page or update one by page ID.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "html": { "type": "string", "minLength": 1 },
        "pageId": { "type": "string", "pattern": "^[0-9A-Za-z]{12}$" },
        "title": { "type": "string", "maxLength": 300 },
        "visibility": { "type": "string", "enum": ["org", "public"] }
      },
      "required": ["html"],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "list_pages",
    "description": "List page metadata in the current organization.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "cursor": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "get_page",
    "description": "Get metadata for one page without returning its HTML.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "pageId": { "type": "string", "pattern": "^[0-9A-Za-z]{12}$" }
      },
      "required": ["pageId"],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "set_page_visibility",
    "description": "Set a page to organization-private or public.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "pageId": { "type": "string", "pattern": "^[0-9A-Za-z]{12}$" },
        "visibility": { "type": "string", "enum": ["org", "public"] }
      },
      "required": ["pageId", "visibility"],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "delete_page",
    "description": "Soft-delete a page in the current organization.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "pageId": { "type": "string", "pattern": "^[0-9A-Za-z]{12}$" }
      },
      "required": ["pageId"],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
