# -----------------------------------------------------------------------------
# Kiosk Docker Compose Environment Configuration Template
# Copy this file to .env before running: docker compose up -d
# -----------------------------------------------------------------------------

# Web & Domain Configuration
# APP_ORIGIN and SERVE_ORIGIN must be two separate domain names or hostnames.
# For local testing, add '127.0.0.1 serve.kiosk.test' to /etc/hosts.
APP_ORIGIN=http://localhost:3000
SERVE_ORIGIN=http://serve.kiosk.test:3000
BETTER_AUTH_URL=http://localhost:3000

# Better Auth Secret (generate with: openssl rand -hex 32)
BETTER_AUTH_SECRET=replace_with_32_byte_hex_secret_abcdef0123456789abcdef0123456789

# Database Configuration (Postgres)
POSTGRES_USER=kiosk
POSTGRES_PASSWORD=kiosk_secure_password_replace_me
POSTGRES_DB=kiosk

# Render Microservice Shared Secret (generate with: openssl rand -hex 32)
RENDER_SHARED_SECRET=replace_with_render_shared_secret_1234567890abcdef1234567890abcdef

# Content Storage Configuration: 'external' (default, local volume or S3/R2/Blob) | 'dual' | 'database'
CONTENT_STORAGE_MODE=external
# Local storage path inside container (persisted via kiosk_storage volume)
STORAGE_LOCAL_DIR=/var/lib/kiosk/storage
# Key used to encrypt external cloud storage credentials (S3/R2/Vercel Blob) if configured in console
STORAGE_CREDENTIAL_KEY=replace_with_32_byte_hex_key_abcdef0123456789abcdef0123456789

# Social OAuth (Optional for local testing, required for production beta)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
